{{define "detail.gohtml"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>reason_turn {{.Turn.ID}} · agent benchmark</title>
<style>
  :root { --line:#e2e5ea; --muted:#6b7280; --head:#f6f7f9; --accent:#1f6feb; }
  * { box-sizing: border-box; }
  body { margin:0; padding:20px 24px 60px; font:13px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif; color:#111; }
  h1 { font-size:18px; margin:0 0 4px; }
  h2 { font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin:22px 0 6px; }
  a { color:var(--accent); text-decoration:none; }
  .sub { color:var(--muted); font-size:12px; margin-bottom:14px; word-break:break-all; }
  dl.meta { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:2px 16px;
            margin:0; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--head); }
  dl.meta div { display:flex; gap:8px; min-width:0; padding:2px 0; }
  dl.meta dt { color:var(--muted); min-width:104px; }
  dl.meta dd { margin:0; word-break:break-word; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12px; }
  pre.box { margin:0; padding:12px; border:1px solid var(--line); border-radius:8px; background:#fcfcfd;
            font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12px;
            white-space:pre-wrap; word-break:break-word; max-height:70vh; overflow:auto; }

  /* input(left) / output(right) pair */
  .pair { display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:start; }
  .side { min-width:0; display:flex; flex-direction:column; }
  .side > h2 { margin-top:22px; }
  .side.in h2 { color:#1d4ed8; }
  .side.out h2 { color:#166534; }
  @media (max-width:900px) { .pair { grid-template-columns:1fr; } }

  /* output view toggle: raw_output <-> normalized_output (never both at once) */
  .viewbar { display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:0 0 10px; font-size:12px; color:var(--muted); }
  .viewbar .k { text-transform:uppercase; letter-spacing:.04em; font-size:11px; }
  .seg { display:inline-flex; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:#fff; }
  .seg a { padding:3px 10px; font-size:11px; text-decoration:none; color:#334155; }
  .seg a + a { border-left:1px solid var(--line); }
  .seg a.on { background:var(--accent); color:#fff; }
  .side.out .variant { color:#166534; }
  [data-out="raw"] [data-out="normalized"],
  [data-out="normalized"] [data-out="raw"] { display:none; }
  .hint { color:var(--muted); font-size:11px; margin:4px 0 0; }
  .tag { display:inline-block; padding:1px 6px; border-radius:10px; background:#eef2f7; font-size:11px; color:#334155; }
</style>
</head>
<body data-out-view-root data-out="{{.OutView}}">
<p><a href="/">« back to list</a> · <a href="/api/reason-turns/{{.Turn.ID}}">json</a></p>
<h1>reason_turn #{{.Turn.ID}}</h1>
<div class="sub">db: {{.DBPath}}</div>

<div class="viewbar">
  <span class="k">output 视图</span>
  <span class="seg">
    <a href="{{.RawViewURL}}" data-out-link="raw" class="{{if eq .OutView "raw"}}on{{end}}">raw_output</a>
    <a href="{{.NormViewURL}}" data-out-link="normalized" class="{{if eq .OutView "normalized"}}on{{end}}">normalized_output</a>
  </span>
  {{if not .Turn.NormalizedOutput}}<span>该 turn 没有 normalized_output</span>{{end}}
</div>

<dl class="meta">
  <div><dt>task_id</dt><dd>{{.Turn.TaskID}}</dd></div>
  <div><dt>agent</dt><dd>{{.Turn.Agent}}</dd></div>
  <div><dt>agent_id</dt><dd>{{.Turn.AgentID}}</dd></div>
  <div><dt>step</dt><dd>{{.Turn.Step}}</dd></div>
  <div><dt>mode</dt><dd><span class="tag">{{.Turn.Mode}}</span></dd></div>
  <div><dt>model</dt><dd>{{.Turn.Model}}</dd></div>
  <div><dt>provider</dt><dd>{{.Turn.Provider}}</dd></div>
  <div><dt>status</dt><dd>{{.Turn.Status}}</dd></div>
  <div><dt>created_at</dt><dd>{{.Turn.CreatedAt}}</dd></div>
  <div><dt>started_at</dt><dd>{{.Turn.StartedAt}}</dd></div>
  <div><dt>ended_at</dt><dd>{{.Turn.EndedAt}}</dd></div>
  <div><dt>duration_ms</dt><dd>{{.Turn.DurationMS}}</dd></div>
  <div><dt>run_id</dt><dd>{{.Turn.RunID}}</dd></div>
  <div><dt>llm_agent_id</dt><dd>{{.Turn.LLMAgentID}}</dd></div>
  <div><dt>llm_events</dt><dd>{{.Turn.EventCount}}</dd></div>
  <div><dt>tokens in/out</dt><dd>{{.Turn.InputTokens}} / {{.Turn.OutputTokens}}</dd></div>
  <div><dt>tokens cache r/w</dt><dd>{{.Turn.CacheReadTokens}} / {{.Turn.CacheWriteTokens}}</dd></div>
  <div><dt>tokens reasoning</dt><dd>{{.Turn.ReasoningTokens}}</dd></div>
  <div><dt>tokens total</dt><dd>{{.Turn.TotalTokens}}</dd></div>
  <div><dt>cost_cents</dt><dd>{{.Cost}}</dd></div>
  {{if .Turn.ErrorCode}}<div><dt>error_code</dt><dd>{{.Turn.ErrorCode}}</dd></div>{{end}}
  {{if .Turn.ErrorMessage}}<div><dt>error_message</dt><dd>{{.Turn.ErrorMessage}}</dd></div>{{end}}
</dl>

<div class="pair">
  <section class="side in">
    <h2>input <span class="hint">({{.InputLen}} chars)</span></h2>
    <pre class="box">{{.Turn.Input}}</pre>
  </section>
  <section class="side out">
    <h2>output · <span class="variant" data-out="raw">raw_output</span><span class="variant" data-out="normalized">normalized_output</span>
      <span class="hint" data-out="raw">{{.OutputLen}} chars</span>
      <span class="hint" data-out="normalized">{{.NormalizedLen}} chars</span>
    </h2>
    <pre class="box" data-out="raw">{{.Turn.Output}}</pre>
    <pre class="box" data-out="normalized">{{if .Turn.NormalizedOutput}}{{.Turn.NormalizedOutput}}{{else}}该 turn 没有 normalized_output（模型返回未归一化）{{end}}</pre>
  </section>
</div>

<script>
// Progressive enhancement: the raw_output / normalized_output toggle switches
// panes instantly; without JavaScript the plain links reload with ?out=.
(function () {
  var root = document.querySelector('[data-out-view-root]');
  if (!root) return;
  function apply(view) {
    root.setAttribute('data-out', view);
    document.querySelectorAll('a[data-out-link]').forEach(function (a) {
      a.classList.toggle('on', a.getAttribute('data-out-link') === view);
    });
    var u = new URL(location.href);
    if (view === 'normalized') u.searchParams.set('out', 'normalized');
    else u.searchParams.delete('out');
    history.replaceState(null, '', u);
  }
  document.addEventListener('click', function (ev) {
    var t = ev.target;
    if (!t || !t.closest) return;
    var a = t.closest('a[data-out-link]');
    if (!a) return;
    ev.preventDefault();
    apply(a.getAttribute('data-out-link'));
  });
})();
</script>
</body>
</html>
{{end}}
