{{define "list.gohtml"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>reason_turns · agent benchmark</title>
<style>
  :root { --line:#e2e5ea; --muted:#6b7280; --head:#f6f7f9; --accent:#1f6feb; }
  * { box-sizing: border-box; }
  body { margin:0; padding:20px 24px 60px; font:13px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
         color:#111; background:#fff; }
  h1 { font-size:18px; margin:0 0 4px; }
  .sub { color:var(--muted); font-size:12px; margin-bottom:14px; word-break:break-all; }
  form.filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px 12px;
                 align-items:end; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--head); }
  .field { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .field label { font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
  select, input[type=text] { width:100%; padding:5px 6px; border:1px solid var(--line); border-radius:5px; background:#fff; font:inherit; }
  .actions { display:flex; gap:8px; }
  button { padding:6px 12px; border:1px solid var(--accent); border-radius:5px; background:var(--accent);
           color:#fff; font:inherit; cursor:pointer; }
  a.reset { align-self:center; color:var(--muted); font-size:12px; }
  .pager { display:flex; gap:12px; align-items:center; margin:14px 0; color:var(--muted); font-size:12px; }
  .pager a { color:var(--accent); text-decoration:none; }

  /* list = metadata only: the input/output texts live on the detail page */
  .hint-row { color:var(--muted); font-size:12px; margin:0 0 8px; }
  table.turns { width:100%; border-collapse:collapse; font-size:12px; }
  table.turns th, table.turns td { padding:6px 8px; border-bottom:1px solid var(--line); text-align:left;
                                   vertical-align:top; white-space:nowrap; }
  table.turns thead th { position:sticky; top:0; background:var(--head); color:var(--muted);
                         font-size:11px; text-transform:uppercase; letter-spacing:.04em; font-weight:600; }
  table.turns td.num, table.turns th.num { text-align:right; }
  tr.turn[data-href] { cursor:pointer; }
  tr.turn:hover { background:#f8fafc; }
  .turn-id { font-weight:700; color:var(--accent); text-decoration:none;
             font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .mono { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .tag { display:inline-block; padding:1px 7px; border-radius:10px; background:#e6ebf5; font-size:11px; color:#334155; }
  .tag.error { background:#fee2e2; color:#991b1b; }
  .tag.plan { background:#ede9fe; color:#5b21b6; }
  .tag.agent { background:#dcfce7; color:#166534; }
  .tag.norm { background:#e0f2fe; color:#075985; }
  .dash { color:var(--muted); }
  td.open a { color:var(--accent); text-decoration:none; }
  .empty { padding:24px; text-align:center; color:var(--muted); }
</style>
</head>
<body>
<h1>reason_turns</h1>
<div class="sub">db: {{.DBPath}} · {{.Total}} matching turns · page {{.PageNumber}} (showing {{.Shown}})</div>

<form class="filters" method="get" action="/">
  <div class="field">
    <label for="task_id">task_id</label>
    <select id="task_id" name="task_id">
      <option value="">all</option>
      {{range .Facets.Tasks}}<option value="{{.Value}}" {{if eq .Value $.Filters.TaskID}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="agent">agent</label>
    <select id="agent" name="agent">
      <option value="">all</option>
      {{range .Facets.Agents}}<option value="{{.Value}}" {{if eq .Value $.Filters.Agent}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="mode">mode</label>
    <select id="mode" name="mode">
      <option value="">all</option>
      {{range .Facets.Modes}}<option value="{{.Value}}" {{if eq .Value $.Filters.Mode}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="model">model</label>
    <select id="model" name="model">
      <option value="">all</option>
      {{range .Facets.Models}}<option value="{{.Value}}" {{if eq .Value $.Filters.Model}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="status">status</label>
    <select id="status" name="status">
      <option value="">all</option>
      {{range .Facets.Statuses}}<option value="{{.Value}}" {{if eq .Value $.Filters.Status}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="q">search input/output</label>
    <input type="text" id="q" name="q" value="{{.Filters.Query}}" placeholder="substring">
  </div>
  <div class="field">
    <label for="limit">page size</label>
    <select id="limit" name="limit">
      {{range .LimitOptions}}<option value="{{.}}" {{if eq . $.Limit}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="order">sort</label>
    <select id="order" name="order">
      {{range .OrderOptions}}<option value="{{.}}" {{if eq . $.Filters.Order}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="dir">direction</label>
    <select id="dir" name="dir">
      <option value="desc" {{if eq .Filters.Dir "desc"}}selected{{end}}>desc</option>
      <option value="asc" {{if eq .Filters.Dir "asc"}}selected{{end}}>asc</option>
    </select>
  </div>
  <div class="actions">
    <button type="submit">apply</button>
    <a class="reset" href="{{.ResetURL}}">reset</a>
  </div>
</form>

<div class="pager">
  <span>page {{.PageNumber}}</span>
  {{if .HasPrev}}<a href="{{.FirstURL}}">« first</a> <a href="{{.PrevURL}}">‹ prev</a>{{end}}
  {{if .HasNext}}<a href="{{.NextURL}}">next ›</a> <a href="{{.LastURL}}">last »</a>{{end}}
</div>

<p class="hint-row">列表只显示元信息（input / output 只给字符数），点 #id 或 view › 到详情页看完整内容。</p>

<table class="turns">
  <thead>
    <tr>
      <th>#</th>
      <th>task_id</th>
      <th>agent</th>
      <th>mode</th>
      <th>model</th>
      <th>status</th>
      <th class="num">step</th>
      <th>created_at</th>
      <th class="num">tokens</th>
      <th class="num">ms</th>
      <th class="num">input chars</th>
      <th class="num">output chars</th>
      <th>normalized_output</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  {{range .Rows}}
    <tr class="turn" data-turn="{{.ID}}" data-href="{{.DetailURL}}">
      <td><a class="turn-id" href="{{.DetailURL}}">#{{.ID}}</a></td>
      <td class="mono">{{.TaskID}}</td>
      <td class="mono">{{.Agent}}</td>
      <td><span class="tag {{if eq .Mode "plan"}}plan{{else if eq .Mode "agent"}}agent{{end}}">{{.Mode}}</span></td>
      <td class="mono">{{.Model}}</td>
      <td><span class="tag{{if eq .Status "error"}} error{{end}}">{{.Status}}</span></td>
      <td class="num">{{.Step}}</td>
      <td class="mono">{{.CreatedAt}}</td>
      <td class="num">{{.TotalTokens}}</td>
      <td class="num">{{.DurationMS}}</td>
      <td class="num">{{.InputLen}}</td>
      <td class="num">{{.OutputLen}}</td>
      <td>{{if .HasNormalized}}<span class="tag norm">✓</span>{{else}}<span class="dash">–</span>{{end}}</td>
      <td class="open"><a href="{{.DetailURL}}">view ›</a></td>
    </tr>
  {{else}}
    <tr><td class="empty" colspan="14">no turns match these filters</td></tr>
  {{end}}
  </tbody>
</table>

<div class="pager">
  <span>page {{.PageNumber}}</span>
  {{if .HasPrev}}<a href="{{.FirstURL}}">« first</a> <a href="{{.PrevURL}}">‹ prev</a>{{end}}
  {{if .HasNext}}<a href="{{.NextURL}}">next ›</a> <a href="{{.LastURL}}">last »</a>{{end}}
</div>
<script>
// Progressive enhancement: clicking anywhere on a row opens that turn's detail
// page. The #id and "view ›" links work on their own without JavaScript.
(function () {
  document.addEventListener('click', function (ev) {
    var t = ev.target;
    if (!t || !t.closest || t.closest('a')) return;
    var row = t.closest('tr[data-href]');
    if (row) location.href = row.getAttribute('data-href');
  });
})();
</script>
</body>
</html>
{{end}}
