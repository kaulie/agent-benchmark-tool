{{define "list.gohtml"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>reason_turns · agent benchmark</title>
<style>
  :root { --line:#e2e5ea; --muted:#6b7280; --head:#f6f7f9; --accent:#1f6feb; --in:#eef6ff; --out:#f3f7f1; }
  * { box-sizing: border-box; }
  body { margin:0; padding:20px 24px 60px; font:13px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
         color:#111; background:#fff; }
  h1 { font-size:18px; margin:0 0 4px; }
  .sub { color:var(--muted); font-size:12px; margin-bottom:14px; word-break:break-all; }
  form.filters { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px 12px;
                 align-items:end; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--head); }
  .field { display:flex; flex-direction:column; gap:4px; min-width:0; }
  .field label { font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
  select, input[type=text] { width:100%; padding:5px 6px; border:1px solid var(--line); border-radius:5px; background:#fff; font:inherit; }
  .actions { display:flex; gap:8px; }
  button { padding:6px 12px; border:1px solid var(--accent); border-radius:5px; background:var(--accent);
           color:#fff; font:inherit; cursor:pointer; }
  a.reset { align-self:center; color:var(--muted); font-size:12px; }
  .pager { display:flex; gap:12px; align-items:center; margin:14px 0; color:var(--muted); font-size:12px; }
  .pager a { color:var(--accent); text-decoration:none; }

  /* one turn = meta line + input(left) / output(right) pair */
  .turn { border:1px solid var(--line); border-radius:10px; margin-bottom:14px; overflow:hidden; }
  .turn-head { display:flex; flex-wrap:wrap; align-items:center; gap:6px 10px; padding:8px 10px;
               background:var(--head); border-bottom:1px solid var(--line); font-size:12px; }
  .turn-id { font-weight:700; color:var(--accent); text-decoration:none;
             font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .turn-head .pair-hint { margin-left:auto; color:var(--muted); font-size:11px; }
  .chip { display:inline-flex; gap:4px; align-items:baseline; }
  .chip .k { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.03em; }
  .chip .v { font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }
  .tag { display:inline-block; padding:1px 7px; border-radius:10px; background:#e6ebf5; font-size:11px; color:#334155; }
  .tag.error { background:#fee2e2; color:#991b1b; }
  .tag.plan { background:#ede9fe; color:#5b21b6; }
  .tag.agent { background:#dcfce7; color:#166534; }

  .pair { display:grid; grid-template-columns:1fr 1fr; gap:0; }
  .pane { min-width:0; display:flex; flex-direction:column; }
  .pane + .pane { border-left:1px solid var(--line); }
  .pane-head { display:flex; align-items:center; gap:6px; padding:5px 10px; font-size:11px;
               text-transform:uppercase; letter-spacing:.04em; color:var(--muted); border-bottom:1px solid var(--line); }
  .pane-head .len { margin-left:auto; text-transform:none; letter-spacing:0; }
  .pane-in .pane-head { background:var(--in); }
  .pane-out .pane-head { background:var(--out); }
  .pane pre { margin:0; padding:10px; white-space:pre-wrap; word-break:break-word;
              font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:12px;
              max-height:190px; overflow:hidden; }
  .pane a.more { padding:6px 10px; font-size:11px; border-top:1px dashed var(--line); color:var(--accent); text-decoration:none; }
  .empty { padding:24px; text-align:center; color:var(--muted); }

  /* narrow screens: stack input above output */
  @media (max-width:900px) {
    .pair { grid-template-columns:1fr; }
    .pane + .pane { border-left:0; border-top:1px solid var(--line); }
  }
</style>
</head>
<body>
<h1>reason_turns</h1>
<div class="sub">db: {{.DBPath}} · {{.Total}} matching turns · page {{.PageNumber}} (showing {{.Shown}})</div>


<form class="filters" method="get" action="/">
  <div class="field">
    <label for="task_id">task_id</label>
    <select id="task_id" name="task_id">
      <option value="">all</option>
      {{range .Facets.Tasks}}<option value="{{.Value}}" {{if eq .Value $.Filters.TaskID}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="agent">agent</label>
    <select id="agent" name="agent">
      <option value="">all</option>
      {{range .Facets.Agents}}<option value="{{.Value}}" {{if eq .Value $.Filters.Agent}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="mode">mode</label>
    <select id="mode" name="mode">
      <option value="">all</option>
      {{range .Facets.Modes}}<option value="{{.Value}}" {{if eq .Value $.Filters.Mode}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="model">model</label>
    <select id="model" name="model">
      <option value="">all</option>
      {{range .Facets.Models}}<option value="{{.Value}}" {{if eq .Value $.Filters.Model}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="status">status</label>
    <select id="status" name="status">
      <option value="">all</option>
      {{range .Facets.Statuses}}<option value="{{.Value}}" {{if eq .Value $.Filters.Status}}selected{{end}}>{{.Value}} ({{.Count}})</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="q">search input/output</label>
    <input type="text" id="q" name="q" value="{{.Filters.Query}}" placeholder="substring">
  </div>
  <div class="field">
    <label for="limit">page size</label>
    <select id="limit" name="limit">
      {{range .LimitOptions}}<option value="{{.}}" {{if eq . $.Limit}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="order">sort</label>
    <select id="order" name="order">
      {{range .OrderOptions}}<option value="{{.}}" {{if eq . $.Filters.Order}}selected{{end}}>{{.}}</option>{{end}}
    </select>
  </div>
  <div class="field">
    <label for="dir">direction</label>
    <select id="dir" name="dir">
      <option value="desc" {{if eq .Filters.Dir "desc"}}selected{{end}}>desc</option>
      <option value="asc" {{if eq .Filters.Dir "asc"}}selected{{end}}>asc</option>
    </select>
  </div>
  <div class="actions">
    <button type="submit">apply</button>
    <a class="reset" href="{{.ResetURL}}">reset</a>
  </div>
</form>

<div class="pager">
  <span>page {{.PageNumber}}</span>
  {{if .HasPrev}}<a href="{{.FirstURL}}">« first</a> <a href="{{.PrevURL}}">‹ prev</a>{{end}}
  {{if .HasNext}}<a href="{{.NextURL}}">next ›</a> <a href="{{.LastURL}}">last »</a>{{end}}
</div>

{{range .Rows}}
<article class="turn" data-turn="{{.ID}}">
  <header class="turn-head">
    <a class="turn-id" href="{{.DetailURL}}">#{{.ID}}</a>
    <span class="chip"><span class="k">task_id</span><span class="v">{{.TaskID}}</span></span>
    <span class="chip"><span class="k">agent</span><span class="v">{{.Agent}}</span></span>
    <span class="tag {{if eq .Mode "plan"}}plan{{else if eq .Mode "agent"}}agent{{end}}">{{.Mode}}</span>
    <span class="chip"><span class="k">model</span><span class="v">{{.Model}}</span></span>
    <span class="tag{{if eq .Status "error"}} error{{end}}">{{.Status}}</span>
    <span class="chip"><span class="k">step</span><span class="v">{{.Step}}</span></span>
    <span class="chip"><span class="k">created</span><span class="v">{{.CreatedAt}}</span></span>
    <span class="pair-hint">input → output · {{.TotalTokens}} tok · {{.DurationMS}} ms</span>
  </header>
  <div class="pair">
    <section class="pane pane-in">
      <div class="pane-head"><span>input</span><span class="len">{{.InputLen}} chars</span></div>
      <pre>{{.InputPreview}}</pre>
      <a class="more" href="{{.DetailURL}}">view full input ›</a>
    </section>
    <section class="pane pane-out">
      <div class="pane-head"><span>output</span><span class="len">raw_output · {{.OutputLen}} chars</span></div>
      <pre>{{.OutputPreview}}</pre>
      <a class="more" href="{{.DetailURL}}">view full output ›</a>
    </section>
  </div>
</article>
{{else}}
<div class="empty">no turns match these filters</div>
{{end}}

<div class="pager">
  <span>page {{.PageNumber}}</span>
  {{if .HasPrev}}<a href="{{.FirstURL}}">« first</a> <a href="{{.PrevURL}}">‹ prev</a>{{end}}
  {{if .HasNext}}<a href="{{.NextURL}}">next ›</a> <a href="{{.LastURL}}">last »</a>{{end}}
</div>
</body>
</html>
{{end}}
